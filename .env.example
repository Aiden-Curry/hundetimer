NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVER_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

CRON_SECRET=replace-with-a-random-string-at-least-16-characters

# Transactional email (Resend)
RESEND_API_KEY=re_YOUR_KEY
EMAIL_FROM=Hundetimer <onboarding@resend.dev>
# During local testing, route every outgoing email to one inbox you control.
EMAIL_TEST_TO=your-email@example.com
# Optional after you have a real support address/domain.
EMAIL_REPLY_TO=
EMAIL_BRAND_NAME=Hundetimer

# Calendar integration (v21)
# Generate a random secret, e.g. PowerShell: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Google Cloud OAuth Web Application
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Entra ID / Azure App Registration (Web)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Optional separate sender for marketing newsletters. Verify your own domain before production.
NEWSLETTER_FROM=Hundetimer <nyheter@hundetimer.no>

# Public legal/business identity shown in trainer terms and contact information.
# Fill these in before inviting real trainers.
NEXT_PUBLIC_HUNDETIMER_LEGAL_NAME=
NEXT_PUBLIC_HUNDETIMER_ORG_NUMBER=
NEXT_PUBLIC_HUNDETIMER_SUPPORT_EMAIL=hei@hundetimer.no
